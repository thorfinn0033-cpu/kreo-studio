# Copy to .env for local testing (netlify dev). On Netlify, add these in
# Site configuration > Environment variables. Never commit the real .env file.

RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be an address on a domain you verified in Resend.
# For quick tests only, "Kreo Studio <onboarding@resend.dev>" works, but it can only email your own Resend account address.
FROM_EMAIL=Kreo Studio <hello@yourdomain.com>
# Where new requests are delivered
TO_EMAIL=you@yourmail.com
# Optional: your live site address, to block requests from other sites
ALLOWED_ORIGIN=https://yourdomain.com

# Optional: save each lead to Airtable (table needs fields: Name, Email, Service, Message)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads
